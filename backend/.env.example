# Copie para backend/.env no modo de desenvolvimento (docs/COMO-RODAR.md, opção B).
# No Docker e no Render estas variáveis vêm do ambiente, não deste arquivo.

# Banco do docker-compose (porta 5433). Aceita também postgresql:// e postgres://
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/injuryrisk

# Assina os tokens de login. Em produção o Render gera uma chave aleatória.
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origem do Vite em desenvolvimento.
CORS_ORIGINS=http://localhost:5173
